// Generated by tools/map-visuals/map_visuals.py visions. Do not edit.

// Vision file for the current map: the PromodFlex grade when one exists, otherwise the stock vision.
visionName()
{
	mapname = getDvar( "mapname" );

	switch ( mapname )
	{
		case "mp_backlot":
		case "mp_citystreets":
		case "mp_crash":
		case "mp_crossfire":
		case "mp_strike":
		case "mp_vacant":
			return "pmflex_" + mapname;
		default:
			return mapname;
	}
}
